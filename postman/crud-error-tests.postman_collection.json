{
  "info": {
    "name": "PersBudg CRUD and Error Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Automated Postman tests for auth and transaction CRUD flows plus error handling."
  },
  "item": [
    {
      "name": "Register Success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var email = `postman.user.${Date.now()}@persbudg.local`;",
              "pm.collectionVariables.set('testEmail', email);",
              "pm.collectionVariables.set('testPassword', 'Password123!');",
              "pm.collectionVariables.set('testName', 'Postman Tester');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('register status is 201', function () { pm.response.to.have.status(201); });",
              "var data = pm.response.json();",
              "pm.test('register returns accessToken', function () { pm.expect(data.accessToken).to.be.a('string').and.not.empty; });",
              "pm.test('register returns refreshToken', function () { pm.expect(data.refreshToken).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('accessToken', data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Login Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login status is 200', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json();",
              "pm.test('login returns accessToken', function () { pm.expect(data.accessToken).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('accessToken', data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Create Transaction Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create transaction status is 201', function () { pm.response.to.have.status(201); });",
              "var data = pm.response.json();",
              "pm.test('transaction has id', function () { pm.expect(data._id).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('transactionId', data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"expense\",\n  \"category\": \"Dining\",\n  \"amount\": 25.5,\n  \"description\": \"Lunch\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Update Transaction Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('update transaction status is 200', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json();",
              "pm.test('amount updated to 30.75', function () { pm.expect(data.amount).to.equal(30.75); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 30.75,\n  \"description\": \"Updated lunch\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions", "{{transactionId}}"]
        }
      }
    },
    {
      "name": "Delete Transaction Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('delete transaction status is 200', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json();",
              "pm.test('delete message is correct', function () { pm.expect(data.message).to.equal('Transaction deleted successfully'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions", "{{transactionId}}"]
        }
      }
    },
    {
      "name": "Error Duplicate Registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('duplicate register status is 409', function () { pm.response.to.have.status(409); });",
              "var data = pm.response.json();",
              "pm.test('duplicate register message', function () { pm.expect(data.message).to.equal('User already exists'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Error Login Invalid Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invalid login status is 401', function () { pm.response.to.have.status(401); });",
              "var data = pm.response.json();",
              "pm.test('invalid login message', function () { pm.expect(data.message).to.equal('Invalid credentials'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"WrongPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Error Unauthorized Transaction Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unauthorized create status is 401', function () { pm.response.to.have.status(401); });",
              "var data = pm.response.json();",
              "pm.test('unauthorized message exists', function () { pm.expect(data.message).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"expense\",\n  \"category\": \"Dining\",\n  \"amount\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Error Invalid Transaction Payload",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invalid transaction payload status is 400', function () { pm.response.to.have.status(400); });",
              "var data = pm.response.json();",
              "pm.test('invalid payload has errors or message', function () { pm.expect(data.errors || data.message).to.exist; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"invalid-type\",\n  \"category\": \"Dining\",\n  \"amount\": -5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Error Invalid Transaction ID on Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invalid id update status is 400', function () { pm.response.to.have.status(400); });",
              "var data = pm.response.json();",
              "pm.test('invalid id message', function () { pm.expect(data.message).to.equal('Invalid transaction id'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions/not-a-valid-id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions", "not-a-valid-id"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" },
    { "key": "testName", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "testPassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "transactionId", "value": "" }
  ]
}

